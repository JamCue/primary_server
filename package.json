    "multer": "^2.2.0",
    "pdf-parse": "1.1.4",
    "validator": "^13.11.0",
    "word-extractor": "^1.0.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn lint && yarn test"
    }
  },
  "_moduleAliases": {
    "@controllers": "build/src/controllers",
    "@dtos": "build/src/dtos",
