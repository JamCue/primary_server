    "gts": "5.0.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "nodemon": "3.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "10.9.1",
    "typescript": "~5.1.6"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.3.0",
    "@google-cloud/pubsub": "4.0.5",
    "@google-cloud/secret-manager": "^5.4.0",
    "busboy": "^1.6.0",
    "cli-color": "^2.0.3",
    "compression": "1.7.4",
    "dotenv": "^16.4.1",
    "express": "4.18.2",
    "express-validator": "7.0.1",
    "firebase-admin": "11.10.1",
    "firebase-functions": "4.4.1",
    "helmet": "7.0.0",
