  "scripts": {
    "start": "PORT=$(grep PORT .env | cut -d '=' -f2) ENV=local functions-framework --source=build/src/ --target=app",
    "watch": "concurrently \"tsc -w\" \"nodemon --watch ./build/ --exec npm run start\"",
    "test": "jest",
    "lint": "gts lint",
    "clean": "gts clean",
    "compile": "tsc",
    "fix": "gts fix",
    "lint:watch": "npm run lint -- --watch",
    "lint:fix": "eslint src --ext .json,.ts --fix",
    "test:fix": "eslint tests --ext .json,.ts --fix",
    "prepare": "husky install && yarn run compile",
    "pretest": "yarn run compile",
    "posttest": "yarn run lint",
    "gh-actions-run-tests": "yarn install --frozen-lockfile && jest && yarn run lint"
  },
  "peerDependencies": {
    "typescript": ">=3"
  },
  "devDependencies": {
    "@jest/types": "^29.6.3",
    "@types/busboy": "^1.5.4",
