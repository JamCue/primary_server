    "@types/express": "4.17.17",
    "@types/http-status-codes": "^1.2.0",
    "@types/jest": "^29.5.4",
    "@types/lodash": "^4.14.198",
    "@types/module-alias": "^2.0.3",
    "@types/moment": "^2.13.0",
    "@types/multer": "^2.2.0",
    "@types/node": "20.4.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/validator": "^13.11.1",
